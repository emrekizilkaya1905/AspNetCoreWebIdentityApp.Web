@model List<AdminModel.RoleViewModel>
@{
    ViewData["Title"] = "Roles";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4">
    <div class="card-header bg-success text-white border-0 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="mb-1">Roles</h3>
                <p class="mb-0">Manage the roles available in your application.</p>
            </div>
            <a class="btn btn-light text-success fw-semibold px-4" asp-area="Admin" asp-controller="Roles" asp-action="RoleCreate">+ Create Role</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
            <span class="fw-semibold">Role List</span>
            <span class="badge bg-success rounded-pill px-3 py-2">@Model.Count roles</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="text-center p-5">
                <h5>No roles yet</h5>
                <p class="text-muted mb-0">Create your first role using the button above.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4 py-3" style="width: 80px;">#</th>
                            <th scope="col" class="py-3">Role Name</th>
                            <th scope="col" class="py-3">Role ID</th>
                            <th scope="col" class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <th scope="row" class="ps-4 py-3 text-muted">@(i + 1)</th>
                                <td class="py-3"><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">@Model[i].Name</span></td>
                                <td class="py-3 text-muted text-break">@Model[i].Id</td>
                                <td class="pe-4 py-3 text-end"><a class="btn btn-outline-success btn-sm" asp-area="Admin" asp-controller="Roles" asp-action="RoleUpdate" asp-route-id="@Model[i].Id">Update</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>