@model AdminModel.RoleUpdateViewModel
@{
    ViewData["Title"] = "Update Role";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-success text-white p-4 border-0">
                <h3 class="mb-1">Update Role</h3>
                <p class="mb-0">Update the role name to manage user permissions.</p>
            </div>
            <div class="card-body p-4">
                <form asp-area="Admin" asp-controller="Roles" asp-action="RoleUpdate" method="post">
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold">Role Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter role name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary">Back to Roles</a>
                        <button type="submit" class="btn btn-success px-4">Update Role</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}