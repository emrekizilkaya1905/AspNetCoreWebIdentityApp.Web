@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card bg-success-subtle border border-success-subtle shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <h2 class="text-success-emphasis mb-2">Reset Password</h2>
                <p class="text-muted mb-4">Choose a new password and enter it again to confirm.</p>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="PasswordConfirm" class="form-label"></label>
                        <input asp-for="PasswordConfirm" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="PasswordConfirm" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2">Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
