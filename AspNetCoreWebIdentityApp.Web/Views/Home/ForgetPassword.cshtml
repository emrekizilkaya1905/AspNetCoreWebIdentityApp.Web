

@model ForgetPasswordViewModel
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial");
}
<div class="row justify-content-center py-4">
    <div class="col-12 col-md-6 col-lg-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
        }
        
        <div class="card bg-success-subtle border border-success-subtle shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <h2 class="text-success-emphasis mb-2">Forget Password</h2>
                <div class="alert alert-info" role="alert">Enter your email address to receive a password reset link.</div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control"
                                autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2">Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>