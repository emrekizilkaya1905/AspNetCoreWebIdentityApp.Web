@using System.Security.Claims

@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle signup-link" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity.Name</a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="accountDropdown">
            <li>
                <a class="dropdown-item" asp-controller="Member" asp-action="Index">Profile</a>
                <a class="dropdown-item" asp-area="" asp-controller="Member" asp-action="Claims">My Claims</a>
                <a class="dropdown-item" asp-area="" asp-controller="Member" asp-action="UserEdit">Edit Profile</a>
                @if (User.HasClaim(x => x.Type == ClaimTypes.Role && x.Value == "admin"))
                {
                    <a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin Panel</a>
                }
                <a class="dropdown-item" asp-controller="Member" asp-action="PasswordChange">Change Password</a>
                <a class="dropdown-item" asp-route-returnUrl="/Home/Index" asp-controller="Member" asp-action="logout">Sign Out</a>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle signup-link" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Account</a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="accountDropdown">
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="SignIn">Sign In</a>
            </li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="SignUp">Sign Up</a>
            </li>
        </ul>
    </li>
}
