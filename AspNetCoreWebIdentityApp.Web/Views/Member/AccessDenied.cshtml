@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-center">
            <div class="card-header bg-success text-white border-0 p-4">
                <span class="badge rounded-pill bg-white text-success px-3 py-2 mb-3">403</span>
                <h1 class="h3 mb-0">Access Denied</h1>
            </div>
            <div class="card-body p-4 p-md-5">
                <h2 class="h5 mb-3">You don't have permission to view this page.</h2>
                <p class="text-muted mb-4">@ViewBag.Message</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-success px-4">Back to Homepage</a>
                    <a asp-area="" asp-controller="Member" asp-action="Index" class="btn btn-outline-success px-4">My Account</a>
                </div>
            </div>
            <div class="card-footer bg-light border-0 py-3">
                <small class="text-muted">Access is limited to authorized users.</small>
            </div>
        </div>
    </div>
</div>