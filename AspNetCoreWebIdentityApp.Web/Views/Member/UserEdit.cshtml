@model UserEditViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card bg-success-subtle border border-success-subtle shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <h2 class="text-success-emphasis mb-2">Edit Profile</h2>
                <p class="text-muted mb-4">Update your personal details and profile picture.</p>

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">@successMessage</div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <form asp-controller="Member" asp-action="UserEdit" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" autocomplete="username" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="BirthDate" class="form-label"></label>
                            <input asp-for="BirthDate" type="date" class="form-control" autocomplete="bday" />
                            <span asp-validation-for="BirthDate" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" autocomplete="address-level2" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select" asp-items="ViewBag.gender">
                            <option value="">Select Gender</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Picture" class="form-label"></label>
                        <input asp-for="Picture" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Picture" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2">Save Changes</button>
                    <div class="text-end mt-3">
                        <a asp-area="" asp-controller="Member" asp-action="Index" class="text-success-emphasis text-decoration-none">Back to my profile</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
