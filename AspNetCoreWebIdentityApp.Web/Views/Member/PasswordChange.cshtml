@model PasswordChangeViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card bg-success-subtle border border-success-subtle shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <h2 class="text-success-emphasis mb-2">Change Password</h2>
                <p class="text-muted mb-4">Enter your current password and choose a new one.</p>

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">@successMessage</div>
                }

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <form asp-area="" asp-controller="Member" asp-action="PasswordChange" method="post">
                    <div class="mb-3">
                        <label asp-for="PasswordOld" class="form-label"></label>
                        <input asp-for="PasswordOld" type="password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="PasswordOld" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PasswordNew" class="form-label"></label>
                        <input asp-for="PasswordNew" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="PasswordNew" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="PasswordNewConfirm" class="form-label"></label>
                        <input asp-for="PasswordNewConfirm" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="PasswordNewConfirm" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2">Change Password</button>
                    <div class="text-end mt-3">
                        <a asp-area="" asp-controller="Member" asp-action="Index" class="text-success-emphasis text-decoration-none">Back to my profile</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
